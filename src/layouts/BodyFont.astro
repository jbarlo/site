---
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/wght-italic.css";
import latinNormal from "@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url";
---

<link
  rel="preload"
  href={latinNormal}
  as="font"
  type="font/woff2"
  crossorigin
/>

<style is:global>
  /* matched to Literata at wght 330, 18px. size-adjust: width ratio;
     overrides: Literata metric / size-adjust. no font-weight: bold synthesises */
  @font-face {
    font-family: "Literata Fallback";
    font-style: normal;
    src: local("Georgia");
    size-adjust: 104.43%;
    ascent-override: 112.71%;
    descent-override: 29.49%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Literata Fallback";
    font-style: italic;
    src: local("Georgia Italic"), local("Georgia-Italic");
    size-adjust: 97.19%;
    ascent-override: 121.1%;
    descent-override: 31.69%;
    line-gap-override: 0%;
  }
  /* no Georgia: Times New Roman, Liberation Serif and Tinos share metrics */
  @font-face {
    font-family: "Literata Fallback Times";
    font-style: normal;
    src:
      local("Times New Roman"), local("TimesNewRomanPSMT"),
      local("Liberation Serif"), local("LiberationSerif"), local("Tinos");
    size-adjust: 114.4%;
    ascent-override: 102.88%;
    descent-override: 26.92%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Literata Fallback Times";
    font-style: italic;
    src:
      local("Times New Roman Italic"), local("TimesNewRomanPS-ItalicMT"),
      local("Liberation Serif Italic"), local("LiberationSerif-Italic"),
      local("Tinos Italic"), local("Tinos-Italic");
    size-adjust: 108.61%;
    ascent-override: 108.37%;
    descent-override: 28.36%;
    line-gap-override: 0%;
  }

  :root {
    --font-body:
      "Literata Variable", "Literata Fallback", "Literata Fallback Times", serif;
  }
</style>
