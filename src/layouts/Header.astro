---
import HeaderTitle from "../components/HeaderTitle";
import NavLink from "../components/NavLink.astro";
import Three from "../layouts/Three.astro";
import { route } from "../utils";

const pages = [
  { url: route("/"), title: "home" },
  { url: route("/about"), title: "about" },
  // { url: "/cal", title: "cal" },
  { url: route("/blog"), title: "blog" },
];

const pathname = Astro.url.pathname;
// barlo/g
const isBlog =
  pathname === route("/blog") || pathname.startsWith(`${route("/blog")}/`);
---

<nav class="sticky top-0 bg-limed-spruce">
  <Three>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
      <HeaderTitle suffix={isBlog ? "g" : undefined} />
      <span class="space-x-4">
        {
          pages.map(({ url, title }) => (
            <NavLink currUrl={Astro.url.pathname} toUrl={url} title={title} />
          ))
        }
      </span>
    </div>
  </Three>
</nav>
