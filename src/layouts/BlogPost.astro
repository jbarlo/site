---
import FormattedDate from "../components/FormattedDate.astro";
import Tag from "../components/Tag.astro";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const created = post.data.created;
const lastUpdated = post.data["last-updated"];
const wasUpdated = created.getTime() !== lastUpdated.getTime();
const { tags } = post.data;

const { Content: PostContent } = await render(post);
---

<article class="page-grid" style={{ "--chars": post.data.title.length }}>
  <h2 class="title">
    {post.data.title}
  </h2>
  <div class="meta">
    <FormattedDate date={created} format="long" />
  </div>
  {
    wasUpdated && (
      <div class="meta">
        updated <FormattedDate date={lastUpdated} format="long" />
      </div>
    )
  }
  <div class="prose">
    <PostContent />
  </div>
  {
    tags.length > 0 && (
      <div class="body-text">
        <span class="text-subdomain">[tags]:</span>
        {tags.map((tag, i) => (
          <>
            {i > 0 && ", "}
            <Tag tag={tag} />
          </>
        ))}
      </div>
    )
  }
</article>
