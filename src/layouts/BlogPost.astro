---
import FormattedDate from "../components/FormattedDate.astro";
import Tag from "../components/Tag.astro";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const created = post.data.created;
const lastUpdated = post.data["last-updated"];
const wasUpdated = created.getTime() !== lastUpdated.getTime();
const { tags } = post.data;

const { Content: PostContent } = await render(post);
---

<article class="page-grid">
  <h2 class="title" style={{ "--chars": post.data.title.length }}>
    {post.data.title}
  </h2>
  <div class="meta">
    <FormattedDate date={created} format="long" />
  </div>
  {
    (wasUpdated || tags.length > 0) && (
      <div class="meta">
        {wasUpdated && (
          <div class="inline-block">
            updated <FormattedDate date={lastUpdated} format="long" />
          </div>
        )}
        {wasUpdated && tags.length > 0 && " "}
        {tags.length > 0 && (
          <div class="inline-flex gap-2 not-italic">
            {tags.map((tag) => (
              <Tag tag={tag} />
            ))}
          </div>
        )}
      </div>
    )
  }
  <div class="prose">
    <PostContent />
  </div>
</article>
