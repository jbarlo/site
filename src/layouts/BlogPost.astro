---
import FormattedDate from "../components/FormattedDate.astro";
import Quiet from "../components/Quiet";
import Tag from "../components/Tag.astro";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const created = post.data.created;
const lastUpdated = post.data["last-updated"];
const wasUpdated = created.getTime() !== lastUpdated.getTime();

const { Content: PostContent } = await render(post);
---

<article class="post">
  <div
    class="flex flex-col gap-x-2 pb-2 sm:flex-row sm:items-end sm:justify-between"
  >
    <h2 class="text-xl text-balance">{post.data.title}</h2>
    <span class="sm:text-right">
      <span class="inline-block">
        <FormattedDate date={created} format="long" />
      </span>
      <span class="inline-block">
        {
          wasUpdated && (
            <Quiet>
              (Last updated: <FormattedDate date={lastUpdated} format="long" />)
            </Quiet>
          )
        }
      </span>
    </span>
  </div>
  {
    post.data.tags.length > 0 && (
      <div class="flex gap-2 pb-3">
        {post.data.tags.map((tag) => (
          <Tag tag={tag} />
        ))}
      </div>
    )
  }
  <div>
    <PostContent />
  </div>
</article>

<style>
  @reference "../styles/global.css";

  .post :global(p) {
    @apply leading-snug;
    @apply pb-3;
  }
  .post :global(img) {
    @apply m-auto;
  }
  .post :global(ul) {
    @apply list-disc;
    @apply list-inside;
    @apply leading-snug;
  }
</style>
