---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Link from "./Link.astro";
import { route } from "../utils";

interface Props {
  post: CollectionEntry<"posts">;
  variant?: "ledger" | "roll";
}

const { post, variant = "ledger" } = Astro.props;
const href = `${route("/blog")}/${post.id}`;
---

{
  variant === "roll" ? (
    <article class="roll page-grid">
      <h3 class="title" style={{ "--chars": post.data.title.length }}>
        <Link href={href}>{post.data.title}</Link>
      </h3>
      <div class="meta">
        <FormattedDate date={post.data.created} format="long" />
      </div>
    </article>
  ) : (
    <div class="entry">
      <FormattedDate date={post.data.created} class="entry-date" />
      <Link href={href}>{post.data.title}</Link>
    </div>
  )
}
