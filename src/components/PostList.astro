---
import type { CollectionEntry } from "astro:content";
import PostListItem from "./PostListItem.astro";
import Quiet from "./Quiet";

interface Props {
  posts: CollectionEntry<"posts">[];
  /** ledger: a date-first line per post. roll: each title, big, with its
   * date in the margin */
  variant?: "ledger" | "roll";
}

const { posts, variant = "ledger" } = Astro.props;
---

{
  posts.length === 0 ? (
    <div class="body-text">
      <Quiet>nothing here yet</Quiet>
    </div>
  ) : (
    <div class:list={[variant === "roll" && "page-grid"]}>
      {posts.map((post) => (
        <PostListItem post={post} variant={variant} />
      ))}
    </div>
  )
}
