---
import Layout from "../../layouts/Layout.astro";
import Header from "../../layouts/Header.astro";
import Three from "../../layouts/Three.astro";
import Footer from "../../layouts/Footer.astro";
import BlogPost from "../../layouts/BlogPost.astro";
import Link from "../../components/Link.astro";
import { getPublishedPosts, route } from "../../utils";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---

<Layout title={`${post.data.title} | barlo`}>
  <div class="bg-limed-spruce text-text">
    <div class="flex min-h-screen flex-col leading-relaxed">
      <Header />
      <Three>
        <Link href={route("/blog")} class="pb-4">← back</Link>
        <BlogPost post={post} />
      </Three>
      <Footer />
    </div>
  </div>
</Layout>
