---
import Page from "../layouts/Page.astro";
import Quiet from "../components/Quiet";
import SectionHeading from "../components/SectionHeading.astro";

const blurb =
  "I'm a developer working out of Vancouver, Canada. I like to pick up and drop problems, sometimes I solve them.";
---

<Page title="about">
  <SectionHeading>james barlow</SectionHeading>
  <div class="prose">
    <p>{blurb}</p>
  </div>
  <SectionHeading>topics</SectionHeading>
  <div class="body-text">
    <div>
      <span class="text-subdomain">[always]:</span>
      systems, serendipity, process, design
    </div>
    <div>
      <span class="text-subdomain">[atm]:</span>
      linux, llms, skateboarding, espresso <Quiet>(yeah I know)</Quiet>
    </div>
    <div>
      <span class="text-subdomain">[backburner]:</span>
      analog photography, 3d printing, gamedev
    </div>
  </div>
</Page>
